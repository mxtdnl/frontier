{
  "name": "frontier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:copy && npm run lint:design && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only auth,database --project demo-frontier \"vitest run --config vitest.rules.config.ts\"",
    "calibrate": "tsx tools/calibrate.ts",
    "bots": "tsx scripts/not-implemented.ts bots",
    "lint:copy": "tsx scripts/lint-copy.ts",
    "shots": "tsx scripts/screenshots.ts",
    "lint:design": "tsx scripts/lint-design.ts",
    "preview": "vite preview",
    "test:e2e": "firebase emulators:exec --config firebase.test.json --only auth,database --project demo-frontier \"tsx scripts/e2e.ts\"",
    "emulators": "firebase emulators:start --config firebase.test.json --only auth,database --project demo-frontier",
    "emulators:rules": "tsx scripts/emulator-rules.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "firebase": "^12.19.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
